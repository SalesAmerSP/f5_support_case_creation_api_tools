# ==============================================================================
# F5 Support Case Creation Tools - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# F5 Domain Artifacts & Generated Files
# ------------------------------------------------------------------------------
# BIG-IP diagnostic support bundles (contain sensitive configs, keys, and logs)
*.qkview

# Generated API case inputs and retrieved metadata JSON files
*.json
# Whitelist IDE configs, test fixtures, and JSON schemas
!.vscode/*.json
!tests/**/*.json
!*.schema.json

# ------------------------------------------------------------------------------
# Secrets & Environment Configurations
# ------------------------------------------------------------------------------
# Local environment variables and credentials (passwords, client-id, client-secret)
.env
.env.*
.envrc
!.env.example

# Private certificates and keys
*.pem
*.key

# ------------------------------------------------------------------------------
# Python Bytecode & Packaging
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / builds
build/
dist/
*.egg-info/
*.egg

# Modern Virtual Environments
.venv/
venv/
env/
ENV/

# ------------------------------------------------------------------------------
# Testing & Code Quality
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.sarif
pip-audit-results.sarif
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# IDEs & Editors
# ------------------------------------------------------------------------------
# VS Code: Ignore workspace state but preserve team configurations
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / PyCharm
.idea/

# ------------------------------------------------------------------------------
# Operating System & General Temporary Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
._*

# Windows
Thumbs.db
[Dd]esktop.ini

# General logs and editor swaps
*.log
*.tmp
*.swp
*~
scratch/