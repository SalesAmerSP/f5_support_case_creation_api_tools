# ==============================================================================
# F5 Support Case Creation Tools - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# F5 Domain Artifacts, Diagnostics & Downloaded Software Images
# ------------------------------------------------------------------------------
# BIG-IP diagnostic support bundles (contain sensitive configs, keys, and logs)
*.qkview

# MyF5 Software Downloads & Virtual Edition Images (prevents multi-GB commits)
*.iso
*.img
*.ova
*.ovf
*.qcow2
*.qcow2.gz
*.vhd
*.vhdx
*.vmdk
*.tgz
*.tar.gz
*.tar
*.zip
*.rpm

# Generated API case inputs, retrieved metadata, and local payload dumps
*.json
# Whitelist tracked repository specifications, schemas, IDE configs, examples, scripts, and test fixtures
!openapi.json
!examples/**/*.json
!examples/*.json
!scripts/**/*.json
!scripts/*.json
!tests/**/*.json
!tests/*.json
!*.schema.json
!.vscode/*.json

# ------------------------------------------------------------------------------
# Secrets & Environment Configurations
# ------------------------------------------------------------------------------
# Local environment variables and credentials (passwords, client-id, client-secret)
.env
.env.*
.envrc
!.env.example

# Private certificates and keys
*.pem
*.key
*.p12
*.pfx
*.pkcs12
.ephemeral_id_rsa*
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*

# F5 credentials files and local profile stores
.ihealth_credentials
*ihealth_credentials*
.f5api_credentials
*.f5api_credentials*
*f5api_credentials*

# General credential files (prevent accidental credentials commits while preserving docs)
*credentials*.ini
*credentials*.json
*credentials*.txt
*credentials*.yaml
*credentials*.yml
.credentials*
*credentials*
!*credentials*.md
!docs/credentials.md

# ------------------------------------------------------------------------------
# Python Bytecode & Packaging
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / builds
build/
dist/
*.egg-info/
*.egg
*.whl

# Modern Virtual Environments
.venv/
venv/
env/
ENV/

# ------------------------------------------------------------------------------
# Testing & Code Quality
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.sarif
pip-audit-results.sarif
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ------------------------------------------------------------------------------
# IDEs & Editors
# ------------------------------------------------------------------------------
# VS Code: Ignore workspace state but preserve team configurations
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / PyCharm
.idea/

# ------------------------------------------------------------------------------
# Operating System & General Temporary Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
._*

# Windows
Thumbs.db
[Dd]esktop.ini

# General logs, editor swaps, and scratch space
*.log
*.tmp
*.swp
*.swo
*~
.#*
scratch/