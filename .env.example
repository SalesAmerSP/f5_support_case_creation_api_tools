# ==============================================================================
# F5 Support Case Creation & QKView Management - Environment Configuration
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# BIG-IP Appliance Configuration
# ------------------------------------------------------------------------------
# Target BIG-IP management hostname or IPv4 address
BIGIP_HOST=52.73.20.25

# BIG-IP management administrative account
BIGIP_USERNAME=admin

# BIG-IP management administrative password
BIGIP_PASSWORD=

# Disable SSL verification for lab appliances using self-signed certificates
# Set to '1', 'true', or 'yes' to disable TLS verification
BIGIP_NO_SSL_VERIFY=true

# Alternative lab BIG-IP appliances (used by integration tests)
BIGIP_HOST_A=52.73.20.25
BIGIP_HOST_B=44.214.252.110

# F5 MyF5 Support & iHealth API Credentials
# ------------------------------------------------------------------------------
# F5 OAuth2 Client ID (from MyF5 API registration)
F5_CLIENT_ID=

# F5 OAuth2 Client Secret
F5_CLIENT_SECRET=

# MyF5 Support Case API Subscription Key (query parameter ?k=...)
F5_MYF5_API_K_VALUE=

# Custom OAuth2 token application ID (default: standard production Okta/Auth0 app)
# F5_IHEALTH_APP_ID=aus1...
# F5_MYF5_APP_ID=aus2...
